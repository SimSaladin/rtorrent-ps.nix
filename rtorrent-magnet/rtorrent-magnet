#!/usr/bin/env bash

set -euo pipefail

usage () {
    cat <<END
usage: rtorrent-magnet MAGNET-TEXT

Will write the magnet-converted-to-torrent file in the current
watch rtorrent instance watch directory (cfg.watch).
END
}

getWatchDirectory () {
    rtxmlrpc method.get=",cfg.watch"
}

if [[ $# -lt 1 ]]; then
    usage
fi

if [[ $1 =~ xt=urn:btih:([^&/]+) ]]; then

    destdir=$(getWatchDirectory)/start
    tofile=$destdir/meta-${BASH_REMATCH[1]}.torrent

    echo "Writing to file: $tofile" >&2

    if [[ -e $tofile ]]; then
        echo "error: the destination file already exists. not overwriting." >&2
        exit 1
    fi

    echo "d10:magnet-uri${#1}:${1}e" > "$tofile"
else
    echo "\"$1\" does not look like a magnet link, ignoring" >&2
    exit 1
fi
